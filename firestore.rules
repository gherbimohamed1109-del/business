rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // كل مستخدم يقرأ ويكتب بياناته فقط
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/{col}/{id} {
      allow read, update, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
    }

    // العميل (بدون تسجيل دخول) يقدر ينشئ طلب فقط، ولا يقرأ شيئاً
    match /users/{uid}/orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','phone','product','qty','address','status','ts'])
        && request.resource.data.keys().hasAll(['name','phone','product','qty','address','status','ts'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.product is string && request.resource.data.product.size() > 0 && request.resource.data.product.size() <= 200
        && request.resource.data.address is string && request.resource.data.address.size() <= 300
        && request.resource.data.qty is int && request.resource.data.qty >= 1 && request.resource.data.qty <= 1000
        && request.resource.data.status == 'new'
        && request.resource.data.ts == request.time;
    }

    // اسم المتجر يظهر في صفحة الطلب
    match /stores/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
